<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>hot_tracks</id>
	<name>Hot Tracks</name>
	<summary>Eigene Aktivitäten aus der activity tracking app privat ablegen</summary>
	<description><![CDATA[Holt Aktivitäten über den fluadrits-Auth-Broker, speichert GPX-Dateien im persönlichen Ordner und zeigt die letzten 7 Tage.]]></description>
	<version>0.1.0</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="mail@walter-precht.de">Walter Precht</author>
	<namespace>HotTracks</namespace>
	<category>integration</category>
	<dependencies>
		<nextcloud min-version="31" max-version="36"/>
	</dependencies>
	<navigations>
		<navigation>
			<id>hot_tracks</id>
			<name>Hot Tracks</name>
			<route>hot_tracks.page.index</route>
			<icon>app.svg</icon>
			<order>25</order>
		</navigation>
	</navigations>
	<settings>
		<admin>OCA\HotTracks\Settings\Admin</admin>
		<admin-section>OCA\HotTracks\Settings\AdminSection</admin-section>
	</settings>
	<background-jobs>
		<job>OCA\HotTracks\BackgroundJob\SyncJob</job>
	</background-jobs>
</info>
