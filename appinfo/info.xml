<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>hot_tracks</id>
	<name>Hot Tracks</name>
	<summary>Eigene Strava-Aktivitäten privat in Nextcloud ablegen</summary>
	<description><![CDATA[Verbindet Strava per direktem OAuth (oder optional Auth-Proxy), holt Aktivitäten (Monat, Jahr, 5 Jahre oder alles), speichert GPX-Dateien im persönlichen Ordner und zeigt die letzten 7 Tage.]]></description>
	<version>1.0.1</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="mail@walter-precht.de">Walter Precht</author>
	<website>https://github.com/macro64/nextcloud_app_hot_tracks</website>
	<bugs>https://github.com/macro64/nextcloud_app_hot_tracks/issues</bugs>
	<repository>https://github.com/macro64/nextcloud_app_hot_tracks</repository>
	<namespace>HotTracks</namespace>
	<category>integration</category>
	<dependencies>
		<nextcloud min-version="32" max-version="36"/>
	</dependencies>
	<navigations>
		<navigation>
			<id>hot_tracks</id>
			<name>Hot Tracks</name>
			<route>hot_tracks.page.index</route>
			<icon>app.svg</icon>
			<order>25</order>
		</navigation>
	</navigations>
	<settings>
		<personal>OCA\HotTracks\Settings\Personal</personal>
		<personal-section>OCA\HotTracks\Settings\AdminSection</personal-section>
		<admin>OCA\HotTracks\Settings\Admin</admin>
		<admin-section>OCA\HotTracks\Settings\AdminSection</admin-section>
	</settings>
	<background-jobs>
		<job>OCA\HotTracks\BackgroundJob\SyncJob</job>
	</background-jobs>
</info>
